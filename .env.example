# Copy to .env (kept local, git-ignored) and fill in. Never commit real credentials.

# ------------------------------------------------------------------------------
# Core Market Intel Django API Configuration
# ------------------------------------------------------------------------------
# Base URL of the existing Django API, INCLUDING the /api suffix, no trailing slash.
# Use HTTPS for any non-local host (http is accepted for localhost only).
MARKET_INTEL_API_BASE_URL=https://your-market-intel-host/api

# Dedicated account with the PRE role (LQ / Manager / superuser accounts are rejected).
MARKET_INTEL_USERNAME=dedicated_pre_username
MARKET_INTEL_PASSWORD=change_me

# Lifetime of a confirmation token in seconds (min 30).
MCP_CONFIRMATION_TTL_SECONDS=600
# Per-request timeout in seconds.
MCP_REQUEST_TIMEOUT_SECONDS=30
# DEBUG | INFO | WARNING | ERROR (logs go to stderr; secrets are never logged)
MCP_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Remote HTTP / SSE Authentication & CORS Security
# ------------------------------------------------------------------------------
# Option 1: Bearer token protection (Authorization: Bearer <secret>)
# Remote HTTP/SSE servers refuse to start unless MCP_AUTH_TOKEN or MCP_OAUTH_ENABLED is set.
# MCP_AUTH_TOKEN=generate_a_long_random_secret_token_here
# Legacy query-param auth (?token=...) is disabled by default for security:
MCP_ALLOW_QUERY_TOKEN=false

# Option 2: OAuth 2.0 Authorization Code + PKCE Sign-In
MCP_OAUTH_ENABLED=false
MCP_OAUTH_ISSUER_URL=https://mcp.yourdomain.com
MCP_ISSUER_URL=https://mcp.yourdomain.com
MCP_OAUTH_DB_PATH=oauth.db
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# Explicit CORS origin allowlist (comma-separated, NEVER '*' when credentials are enabled)
MCP_CORS_ALLOWED_ORIGINS=https://claude.ai,https://grok.com

# ------------------------------------------------------------------------------
# AI Providers & Intelligent Routing (API credentials only; never consumer ChatGPT)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Routing: Stage 2 (primary lightweight) -> Stage 3 (escalation) -> fallback
RESEARCH_PRIMARY_LLM_PROVIDER=groq
RESEARCH_ESCALATION_LLM_PROVIDER=anthropic
RESEARCH_FALLBACK_LLM_PROVIDER=openai

RESEARCH_PRIMARY_MODEL=llama-3.3-70b-versatile
RESEARCH_ESCALATION_MODEL=claude-sonnet-4-20250514
RESEARCH_FALLBACK_MODEL=gpt-4o-mini

# Optional per-provider model overrides
# GROQ_MODEL=
# ANTHROPIC_MODEL=
# OPENAI_MODEL=

# ------------------------------------------------------------------------------
# Web Search Providers (for discovering official websites, filings, and events)
# ------------------------------------------------------------------------------
# auto | brave | tavily | serper | duckduckgo | none
RESEARCH_SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
RESEARCH_SEARCH_ENABLE_DDG_FALLBACK=true

# ------------------------------------------------------------------------------
# Company Research Engine, Vortexen Profile & Token Optimization Cache
# ------------------------------------------------------------------------------
VORTEXEN_WEBSITE_URL=https://vortexen.com/
VORTEXEN_PROFILE_TTL_SECONDS=604800

RESEARCH_CACHE_DB_PATH=research_cache.db
RESEARCH_FIELD_TTL_SECONDS=604800
RESEARCH_VOLATILE_FIELD_TTL_SECONDS=259200
RESEARCH_SOURCE_TTL_SECONDS=86400

RESEARCH_MAX_PAGES_PER_COMPANY=8
RESEARCH_MAX_EVENT_PARTICIPANTS=25
RESEARCH_MAX_CONCURRENCY=3
RESEARCH_FETCH_TIMEOUT_SECONDS=12
RESEARCH_MAX_RESPONSE_BYTES=1500000
RESEARCH_MAX_CONTEXT_CHARS=12000
RESEARCH_MAX_LLM_CALLS_PER_COMPANY=6
RESEARCH_MAX_TOKENS_PER_COMPANY=25000
RESEARCH_RESPECT_ROBOTS_TXT=true
