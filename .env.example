# Copy to .env (kept local, git-ignored) and fill in. Never commit real credentials.

# Base URL of the existing Django API, INCLUDING the /api suffix, no trailing slash.
# Use HTTPS for any non-local host (http is accepted for localhost only).
MARKET_INTEL_API_BASE_URL=https://your-market-intel-host/api

# Dedicated account with the PRE role (LQ / Manager / superuser accounts are rejected).
MARKET_INTEL_USERNAME=dedicated_pre_username
MARKET_INTEL_PASSWORD=change_me

# Lifetime of a confirmation token in seconds (min 30).
MCP_CONFIRMATION_TTL_SECONDS=600
# Per-request timeout in seconds.
MCP_REQUEST_TIMEOUT_SECONDS=30
# DEBUG | INFO | WARNING | ERROR (logs go to stderr; secrets are never logged)
MCP_LOG_LEVEL=INFO

# Optional: Shared secret token to protect remote HTTP/SSE endpoints (e.g. on AWS/Cloud).
# If set, Claude or callers must connect with ?token=<this_secret> or Authorization: Bearer <this_secret>.
# Claude.ai connector URL format: https://your-server.com/mcp?token=your_secret_token_here
MCP_AUTH_TOKEN=generate_a_long_random_secret_token_here

